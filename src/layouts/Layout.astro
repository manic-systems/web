---
interface Props { title?: string; description?: string; }
const {
  title = 'manic.systems',
  description = 'Free software from manic.systems. Nix infrastructure, shells, system utilities, and libraries.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101010" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/doto-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/commit-mono-latin-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body><slot /></body>
</html>
<style is:global>
  @font-face {
    font-family: Doto;
    src: url('/fonts/doto-latin-variable.woff2') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Commit Mono';
    src: url('/fonts/commit-mono-latin-400.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  :root {
    color-scheme: dark;
    --bg: #101010;
    --text: #e8e8e8;
    --muted: #999999;
    --line: #343434;
    --hover: #1b1b1b;
    --masthead-wave-1: #c8c8c8;
    --masthead-wave-2: #aaaaaa;
    --masthead-wave-3: #aaaaaa;
    --masthead-wave-4: #c8c8c8;
    --mono: 'Commit Mono', ui-monospace, monospace;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); color: var(--text); font-family: var(--mono); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; scroll-padding-block-start: 24px; }
  body { margin: 0; }
  a { color: inherit; text-decoration: none; }
  svg { display: block; }
  h1, h2, h3, p { margin: 0; }
  p { text-wrap: pretty; }
  :focus-visible { outline: 2px solid var(--text); outline-offset: 5px; }
  ::selection { color: var(--bg); background: var(--text); }
  .rail-label { display: flex; align-items: center; gap: 10px; margin-block-end: 12px; color: var(--muted); font-size: 0.75rem; }
  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }
</style>
