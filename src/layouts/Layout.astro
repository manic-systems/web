---
interface Props { title?: string; description?: string; }
const {
  title = 'manic.systems',
  description = 'Free software from manic.systems. Nix infrastructure, shells, system utilities, and libraries.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101010" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/doto-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/commit-mono-latin-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body><slot /></body>
</html>
<style is:global>
  @font-face {
    font-family: Doto;
    src: url('/fonts/doto-latin-variable.woff2') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Commit Mono';
    src: url('/fonts/commit-mono-latin-400.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  :root {
    color-scheme: dark;
    --bg: #101010;
    --text: #e8e8e8;
    --muted: #999999;
    --line: #343434;
    --hover: #1b1b1b;
    --mono: 'Commit Mono', ui-monospace, monospace;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); color: var(--text); font-family: var(--mono); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; scroll-padding-block-start: 24px; }
  body { margin: 0; }
  a { color: inherit; text-decoration: none; }
  svg { display: block; }
  h1, h2, h3, p { margin: 0; }
  p { text-wrap: pretty; }
  :focus-visible { outline: 2px solid var(--text); outline-offset: 5px; }
  ::selection { color: var(--bg); background: var(--text); }
  .skip { position: absolute; inset-block-start: 12px; inset-inline-start: 24px; transform: translateY(-160%); padding: 12px 16px; background: var(--text); color: var(--bg); z-index: 2; }
  .skip:focus { transform: translateY(0); }
  .site { max-width: 1440px; margin-inline: auto; padding-inline: 48px; }
  .topbar { min-height: 92px; display: flex; align-items: center; justify-content: space-between; gap: 24px; border-block-end: 1px solid var(--line); }
  .brand { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; font-size: 0.875rem; }
  .brand svg { width: 32px; height: 32px; }
  .outlinks { display: flex; align-items: center; flex-wrap: wrap; gap: 28px; font-size: 0.8125rem; }
  .outlinks a { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; }
  .outlinks a:hover, .rail a:hover, .bottom a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .outlinks .sponsor-button { padding-inline: 14px; border: 1px solid var(--muted); gap: 10px; }
  .outlinks .sponsor-button:hover { background: var(--hover); border-color: var(--text); text-decoration: none; }
  .layout { display: grid; grid-template-columns: 208px minmax(0, 1fr); column-gap: 64px; }
  .rail { align-self: start; padding-block: 48px; font-size: 0.8125rem; line-height: 1.6; }
  .rail-intro { max-width: 23ch; color: var(--muted); }
  .rail-intro strong { display: block; color: var(--text); font-weight: 400; margin-block-end: 12px; }
  .rail-label { display: flex; align-items: center; gap: 10px; margin-block-end: 12px; color: var(--muted); font-size: 0.75rem; }
  .rail-nav { margin-block: 40px; }
  .rail-nav a { display: flex; justify-content: space-between; gap: 12px; min-height: 40px; align-items: center; }
  .nav-label { display: inline-flex; align-items: center; gap: 10px; }
  .rail-nav .area-count { color: var(--muted); font-variant-numeric: tabular-nums; }
  .people a { display: block; width: fit-content; max-width: 100%; overflow-wrap: anywhere; min-height: 36px; padding-block: 8px; }
  main { min-width: 0; }
  .masthead { position: relative; padding-block: 32px 40px; }
  h1 { font-family: Doto, var(--mono); font-size: min(8.3vw, 7.5rem); font-weight: 850; line-height: 1.1; letter-spacing: -0.045em; }
  .masthead h1 span { display: block; }
  .masthead-foot { display: flex; justify-content: space-between; align-items: end; gap: 32px; margin-block-start: 24px; color: var(--muted); font-size: 0.8125rem; line-height: 1.6; }
  .seed-mark { width: 72px; height: 32px; flex-shrink: 0; color: var(--muted); }
  .index-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-block: 18px; border-block: 1px solid var(--text); }
  .index-head h2 { font-size: 0.875rem; font-weight: 400; }
  .index-head p { font-size: 0.75rem; color: var(--muted); }
  .group { padding-block: 32px 40px; scroll-margin-block-start: 24px; }
  .group + .group { border-block-start: 1px solid var(--line); }
  .group-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px 20px; margin-block-end: 24px; }
  .group-heading h3 { font-size: 0.875rem; font-weight: 400; }
  .group-heading p { font-size: 0.75rem; color: var(--muted); }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; row-gap: 8px; list-style: none; padding: 0; margin: 0; }
  .project-link { display: block; padding: 14px 12px; margin-inline: -12px; min-height: 106px; }
  .project-link:hover { background: var(--hover); }
  .project-title { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-block-end: 9px; }
  .project-name { font-size: 1.25rem; overflow-wrap: anywhere; }
  .project-arrow { color: var(--muted); font-size: 0.875rem; }
  .project-link:hover .project-name { text-decoration: underline; text-underline-offset: 5px; }
  .project-link:hover .project-arrow { color: var(--text); }
  .project-desc { color: var(--muted); font-size: 0.875rem; line-height: 1.6; max-width: 44ch; }
  .project-note { font-size: 0.75rem; color: var(--muted); margin-block-start: 8px; }
  .bottom { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px 32px; padding-block: 20px 28px; border-block-start: 1px solid var(--line); font-size: 0.75rem; color: var(--muted); }
  .bottom a { display: inline-flex; align-items: center; min-height: 36px; }
  .mobile-people { display: none; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  @media (max-width: 1100px) {
    .site { padding-inline: 32px; }
    .layout { grid-template-columns: 168px minmax(0, 1fr); column-gap: 40px; }
    .project-grid { column-gap: 24px; }
  }
  @media (max-width: 780px) {
    .site { padding-inline: 24px; }
    .topbar { min-height: 76px; }
    .layout { grid-template-columns: minmax(0, 1fr); }
    .rail { padding-block: 24px 0; }
    .rail-intro { max-width: 60ch; }
    .rail-intro strong { display: inline; margin: 0; }
    .rail-nav { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-block: 20px 0; }
    .rail-nav .rail-label { display: none; }
    .rail-nav a { gap: 12px; }
    .rail .people { display: none; }
    .masthead { padding-block: 24px 32px; }
    h1 { font-size: min(14vw, 7rem); }
    .masthead-foot { margin-block-start: 16px; }
    .group { padding-block: 28px 32px; }
    .mobile-people { display: block; margin-block-end: 24px; padding-block-start: 24px; border-block-start: 1px solid var(--line); font-size: 0.8125rem; }
    .mobile-people .people { display: flex; flex-wrap: wrap; gap: 4px 24px; }
  }
  @media (max-width: 500px) {
    .site { padding-inline: 20px; }
    .topbar { gap: 16px; flex-wrap: wrap; padding-block: 12px; }
    .outlinks { gap: 20px; }
    .brand { font-size: 0.8125rem; }
    .brand svg { width: 26px; height: 26px; }
    .project-grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .project-link { min-height: 0; padding-block: 16px; }
    .group-heading { margin-block-end: 12px; }
    .masthead-foot { gap: 20px; }
    .seed-mark { width: 48px; }
    .index-head p { font-size: 0.75rem; }
  }
</style>
