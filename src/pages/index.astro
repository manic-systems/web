---
import { getCollection } from 'astro:content';
import Masthead from '@/components/Masthead.astro';
import OrganizationSidebar from '@/components/OrganizationSidebar.astro';
import People from '@/components/People.astro';
import ProjectIndex from '@/components/ProjectIndex.astro';
import { projectAreas } from '@/data/projects';
import { getMembers } from '@/data/users';
import Layout from '@/layouts/Layout.astro';

const [projects, members] = await Promise.all([getCollection('projects'), getMembers()]);
projects.sort((a, b) => {
  const aOrder = a.data.order ?? Infinity;
  const bOrder = b.data.order ?? Infinity;
  return aOrder === bOrder ? a.id.localeCompare(b.id) : aOrder - bOrder;
});
const groups = projectAreas.map((area) => ({
  ...area,
  projects: projects.filter((project) => project.data.area === area.id),
}));
---

<Layout>
  <a slot="before-header" class="skip" href="#software">Skip to software</a>
  <div class="layout">
    <OrganizationSidebar groups={groups}>
      <People members={members} />
    </OrganizationSidebar>
    <main>
      <Masthead />
      <ProjectIndex groups={groups} />
    </main>
  </div>
  <People slot="before-footer" members={members} mobile />
</Layout>

<style>
  .skip { position: absolute; inset-block-start: 12px; inset-inline-start: 24px; transform: translateY(-160%); padding: 12px 16px; background: var(--text); color: var(--bg); z-index: 2; }
  .skip:focus { transform: translateY(0); }
  .layout { display: grid; grid-template-columns: 208px minmax(0, 1fr); column-gap: 64px; }
  main { min-width: 0; }
  @media (max-width: 1100px) {
    .layout { grid-template-columns: 168px minmax(0, 1fr); column-gap: 40px; }
  }
  @media (max-width: 780px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
  }
</style>
