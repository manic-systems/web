---
import { github, matrix } from '@/data/site';
const year = new Date().getUTCFullYear();
---

<footer class="bottom">
  <nav class="quick-links" aria-label="Quick links">
    <a href={github}>GitHub ↗</a>
    <a href={matrix}>Matrix ↗</a>
    <a href="https://github.com/sponsors/manic-systems">Sponsor ↗</a>
    <a href={`${github}/web`}>Source ↗</a>
  </nav>
  <span class="copyright">© {year} manic.systems</span>
  <a class="go-up" href="#top">Go up ↑</a>
</footer>

<style>
  .bottom { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 12px 32px; padding-block: 20px 28px; border-block-start: 1px solid var(--line); font-size: 0.75rem; color: var(--muted); }
  .quick-links { display: flex; flex-wrap: wrap; gap: 0 16px; }
  .copyright { text-align: center; }
  .go-up { justify-self: end; white-space: nowrap; }
  .bottom a { display: inline-flex; align-items: center; min-height: 36px; }
  .bottom a:hover { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 780px) {
    .bottom { grid-template-columns: minmax(0, 1fr) auto; gap: 12px 20px; }
    .copyright { grid-column: 1 / -1; grid-row: 2; }
    .go-up { grid-column: 2; grid-row: 1; }
  }
</style>
