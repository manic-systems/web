---
import { bitmapSeed } from '../data/site';
import { DOT_SIZE, LETTERING, TITLE } from '../lib/masthead/lettering';

const dotInset = (1 - DOT_SIZE) / 2;

let state = bitmapSeed >>> 0;
const cells = Array.from({ length: 48 }, (_, i) => {
  state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
  return {
    x: (i % 12) * 6,
    y: Math.floor(i / 12) * 8,
    filled: state / 4294967296 > 0.4,
  };
});
---

<div class="masthead">
  <canvas class="water" aria-hidden="true"></canvas>
  <h1>
    <span class="visually-hidden">{TITLE}</span>
    <svg
      class="lettering"
      viewBox={`0 0 ${LETTERING.cols} ${LETTERING.rows}`}
      style={`width: calc(var(--pitch) * ${LETTERING.cols}); height: calc(var(--pitch) * ${LETTERING.rows})`}
      fill="currentColor"
      aria-hidden="true"
    >
      {LETTERING.dots.map(([x, y]) => (
        <rect
          x={x + dotInset}
          y={y + dotInset}
          width={DOT_SIZE}
          height={DOT_SIZE}
        />
      ))}
    </svg>
  </h1>
  <div class="masthead-foot">
    <svg class="seed-mark" viewBox="0 0 72 32" aria-hidden="true" data-seed={bitmapSeed}>
      {cells
        .filter((cell) => cell.filled)
        .map(({ x, y }) => (
          <rect x={x} y={y} width="3" height="5" fill="currentColor" />
        ))}
    </svg>
  </div>
</div>

<style>
  /* One Doto dot pitch (0.1em of the former lettering size). */
  .masthead { --pitch: min(0.83vw, 12px); --bleed: 3; --water-enabled: 0; position: relative; padding-block: 32px 40px; }
  .masthead > :not(.water) { position: relative; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .masthead-foot { display: flex; justify-content: end; margin-block-start: 24px; }
  .seed-mark { width: 72px; height: 32px; flex-shrink: 0; color: var(--muted); }
  /* The water bleeds --bleed dots past the masthead on every side and fades out there. */
  .water {
    --edge: calc(var(--pitch) * var(--bleed));
    display: none;
    position: absolute;
    inset-block-start: calc(var(--edge) * -1);
    inset-inline-start: calc(var(--edge) * -1);
    width: calc(100% + var(--edge) * 2);
    height: calc(100% + var(--edge) * 2);
    pointer-events: none;
    mask-image:
      linear-gradient(
        to right,
        transparent,
        #000 var(--edge),
        #000 calc(100% - var(--edge)),
        transparent
      ),
      linear-gradient(
        to bottom,
        transparent,
        #000 var(--edge),
        #000 calc(100% - var(--edge)),
        transparent
      );
    mask-composite: intersect;
  }
  .masthead.has-water .water {
    display: block;
  }
  .masthead.has-water .lettering {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    @media (forced-colors: none) {
      .masthead {
        --water-enabled: 1;
      }
    }
  }
  @media (max-width: 780px) {
    .masthead { --pitch: min(1.4vw, 11.2px); padding-block: 24px 32px; }
    .masthead-foot { margin-block-start: 16px; }
  }
  @media (max-width: 500px) {
    .seed-mark { width: 48px; }
  }
</style>

<script>
  import { Masthead } from "../lib/masthead/masthead";

  const root = document.querySelector<HTMLElement>(".masthead");
  const canvas = root?.querySelector<HTMLCanvasElement>(".water");
  const letters = root?.querySelector<SVGSVGElement>(".lettering");

  // CSS owns accessibility gating; the SVG lettering stays as the static fallback.
  const enabled =
    root &&
    getComputedStyle(root).getPropertyValue("--water-enabled").trim() === "1";

  if (root && canvas && letters && enabled) {
    root.classList.add("has-water");
    new Masthead(root, canvas, letters).start();
  }
</script>
