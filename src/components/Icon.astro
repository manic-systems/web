---
const paths = {
  index: 'M8 6h12M8 12h12M8 18h12M3 6h.01M3 12h.01M3 18h.01',
  people: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  systems: 'M7 7h10v10H7ZM10 10h4v4h-4ZM9 3v4M15 3v4M9 17v4M15 17v4M3 9h4M3 15h4M17 9h4M17 15h4',
  shell: 'M4 4h16v16H4ZM8 9l3 3-3 3M13 15h3',
  libraries: 'm12 3 9 5-9 5-9-5 9-5ZM3 12l9 5 9-5M3 16l9 5 9-5',
  menu: 'M4 7h16M4 12h16M4 17h16',
  sponsor: 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z',
};
interface Props {
  name: keyof typeof paths | 'github' | 'matrix' | 'nix';
}
const { name } = Astro.props;
const isBrand = name === 'github' || name === 'matrix' || name === 'nix';
---

{isBrand ? (
  <span class="icon brand-icon" style={`--icon: url(/icons/${name}.svg)`} aria-hidden="true"></span>
) : (
  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d={paths[name as keyof typeof paths]} />
  </svg>
)}

<style>
  .icon { display: inline-block; width: 16px; height: 16px; flex-shrink: 0; vertical-align: middle; }
  .brand-icon { background: currentColor; mask: var(--icon) center / contain no-repeat; }
</style>
